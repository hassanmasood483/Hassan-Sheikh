{% comment %}
  ==============================
  Custom Banner Section
  - Editable title, subtitle, button
  - Customizable background + button colors
  - Smooth hover animation
  ==============================
{% endcomment %}

<section class="custom-banner">
  <div class="custom-banner__overlay">
    <div class="custom-banner__content">
      <h1 class="custom-banner__title">{{ section.settings.heading }}</h1>
      <p class="custom-banner__subtitle">{{ section.settings.subheading }}</p>
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="custom-banner__btn">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to Our Store"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our latest collection"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Text",
      "default": "Shopppp"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button Color",
      "default": "#ff6f61"
    }
  ],
  "presets": [
    {
      "name": "Custom Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<style>
  .custom-banner {
    background: {{ section.settings.background_color }};
    color: #fff;
    text-align: center;
    padding: 120px 20px;
    position: relative;
  }

  .custom-banner__title {
    font-size: 3rem;
    margin-bottom: 10px;
    font-weight: 700;
  }

  .custom-banner__subtitle {
    font-size: 1.2rem;
    margin-bottom: 20px;
    opacity: 0.85;
  }

  .custom-banner__btn {
    display: inline-block;
    padding: 12px 28px;
    background: {{ section.settings.button_color }};
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    border-radius: 4px;
    transition: transform 0.3s ease, background 0.3s ease;
  }

  .custom-banner__btn:hover {
    transform: translateY(-3px);
    background: darken({{ section.settings.button_color }}, 10%);
  }

  /* Responsive tweaks */
  @media (max-width: 768px) {
    .custom-banner__title {
      font-size: 2rem;
    }
    .custom-banner__subtitle {
      font-size: 1rem;
    }
  }
</style>
